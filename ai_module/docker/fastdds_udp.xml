<?xml version="1.0" encoding="UTF-8" ?>
<!-- UDP only, no SHM transport, no DataSharing. Cross-container FastDDS on host
     networking otherwise matches writers via /dev/shm and drops /way_point_with_heading
     and /challenge_question (HISTORY_DATASHARING_PAYLOADPOOL: No such file). -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
    <data_writer profile_name="default_datawriter_udp" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_writer>
    <data_reader profile_name="default_datareader_udp" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_reader>
    <publisher profile_name="default_publisher_udp" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </publisher>
    <subscriber profile_name="default_subscriber_udp" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </subscriber>
  </profiles>
</dds>
